{
  "name": "forgefit-supply-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for ForgeFit Supply, a gym and sport equipment shop.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:cleanup": "tsx --env-file-if-exists=.env scripts/cleanup-images.ts",
    "smoke": "node scripts/smoke.mjs",
    "maintenance:once": "tsx --env-file-if-exists=.env scripts/maintain.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "stripe": "^22.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
