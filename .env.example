# Copy to .env for local development: cp .env.example .env
# On Render these are set in the service's Environment tab instead.

# development | test | production
NODE_ENV=development

# Port the HTTP server binds to. Render injects its own PORT, so leave it unset there.
# 4000 matches the frontend's NEXT_PUBLIC_API_URL default.
PORT=4000

# Optional: debug | info | warn | error (defaults to debug locally, info in production)
# LOG_LEVEL=debug

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys: a secret key (sb_secret_...) or the legacy service_role key.
# Bypasses Row Level Security: server-side only, never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of browser origins allowed by CORS (no trailing slash needed).
# http://localhost:3000 is always allowed outside production.
CORS_ORIGINS=https://your-frontend.vercel.app

# Stripe checkout (optional: without these, checkout responds 503 and the rest works).
# Stripe Dashboard (test mode) > Developers > API keys > Secret key.
# STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# Locally, `stripe listen` prints one instead.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Order confirmation emails via Resend (optional: without a key, no emails are sent).
# resend.com > API Keys. With the default sender (onboarding@resend.dev), Resend only
# delivers to your own account's email address; verify a domain to email customers.
# RESEND_API_KEY=re_...
# EMAIL_FROM="ForgeFit Supply <orders@your-domain.com>"

# Optional: where shoppers land after paying. Defaults to the first CORS_ORIGINS entry
# (or http://localhost:3000 in development).
# STOREFRONT_URL=https://your-frontend.vercel.app
